{
  "info": {
    "name": "HLF Demo API",
    "description": "Hyperledger Fabric REST API client",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health",
        "description": "Check service and ledger health. No auth required."
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "    console.log('Token saved to collection variable.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"asdqwe123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Login and get JWT token. Token is auto-saved to {{token}} variable."
          }
        }
      ]
    },
    {
      "name": "Assets",
      "item": [
        {
          "name": "Get All Assets",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/assets"
          }
        },
        {
          "name": "Get Asset by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/assets/asset1"
          }
        },
        {
          "name": "Create Asset",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"asset1\",\n  \"color\": \"blue\",\n  \"size\": 10,\n  \"owner\": \"Alice\",\n  \"appraisedValue\": 500\n}"
            },
            "url": "{{baseUrl}}/api/v1/assets"
          }
        },
        {
          "name": "Update Asset",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"color\": \"red\",\n  \"size\": 20,\n  \"owner\": \"Alice\",\n  \"appraisedValue\": 999\n}"
            },
            "url": "{{baseUrl}}/api/v1/assets/asset1"
          }
        },
        {
          "name": "Delete Asset",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/assets/asset1"
          }
        },
        {
          "name": "Transfer Asset",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newOwner\": \"Bob\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/assets/asset1/transfer"
          }
        },
        {
          "name": "Get Asset History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/assets/asset1/history"
          }
        },
        {
          "name": "Get Assets by Range",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/assets/range?startKey=asset1&endKey=asset9",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "assets", "range"],
              "query": [
                { "key": "startKey", "value": "asset1" },
                { "key": "endKey", "value": "asset9" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Channels",
      "item": [
        {
          "name": "Get Channels",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/channels"
          }
        },
        {
          "name": "Get Channel Info",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/channels/mychannel"
          }
        }
      ]
    },
    {
      "name": "Chaincodes",
      "item": [
        {
          "name": "Get Chaincodes",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/chaincodes"
          }
        },
        {
          "name": "Get Chaincode Info",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/chaincodes/basic"
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Get Transactions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/transactions",
            "description": "Not implemented (501)"
          }
        },
        {
          "name": "Get Transaction by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/transactions/txid-here",
            "description": "Not implemented (501)"
          }
        }
      ]
    },
    {
      "name": "Network",
      "item": [
        {
          "name": "Get Peers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/network/peers"
          }
        },
        {
          "name": "Get Organizations",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/network/organizations"
          }
        },
        {
          "name": "Get Connection Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/network/connection-profile"
          }
        }
      ]
    },
    {
      "name": "Identities (CA)",
      "description": "MSP identity management via Fabric CA. Requires CA_ADMIN_MSP_DIR env var pointing to bootstrap-admin MSP.",
      "item": [
        {
          "name": "List Identities",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/identities",
            "description": "List all identities registered in the CA."
          }
        },
        {
          "name": "Get Identity",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/identities/user1",
            "description": "Get details of a specific identity by ID."
          }
        },
        {
          "name": "Register Identity",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"newuser1\",\n  \"type\": \"client\",\n  \"affiliation\": \"org1\",\n  \"secret\": \"newuser1pw\",\n  \"maxEnrollments\": -1\n}"
            },
            "url": "{{baseUrl}}/api/v1/identities/register",
            "description": "Register a new identity with the CA. Returns the enrollment secret."
          }
        },
        {
          "name": "Enroll Identity",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"newuser1\",\n  \"secret\": \"newuser1pw\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/identities/enroll",
            "description": "Enroll an identity to get a certificate. Cert and key stored in walletPath/<name>/msp."
          }
        },
        {
          "name": "Delete Identity",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/identities/newuser1",
            "description": "Remove an identity from the CA."
          }
        }
      ]
    }
  ]
}
