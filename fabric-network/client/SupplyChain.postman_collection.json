            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"EVT-002\",\n  \"targetId\": \"{{productId}}\",\n  \"targetType\": \"PRODUCT\",\n  \"eventType\": \"TEMPERATURE\",\n  \"description\": \"Cold chain temperature check at distributor warehouse\",\n  \"location\": \"Surabaya Cold Storage\",\n  \"occurredAt\": \"2026-05-08T14:30:00Z\",\n  \"data\": {\n    \"temp_celsius\": \"4.2\",\n    \"humidity_pct\": \"68\",\n    \"sensor_id\": \"SENSOR-44\"\n  }\n}"
