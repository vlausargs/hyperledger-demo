        {
          "name": "Log Event — Quality Inspection",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"EVT-003\",\n  \"targetId\": \"{{productId}}\",\n  \"targetType\": \"PRODUCT\",\n  \"eventType\": \"INSPECTION\",\n  \"description\": \"Incoming quality control inspection passed\",\n  \"location\": \"Distributor QC Lab, Surabaya\",\n  \"occurredAt\": \"2026-05-08T16:00:00Z\",\n  \"data\": {\n    \"result\": \"PASS\",\n    \"inspector_id\": \"QC-221\",\n    \"batch_sample_size\": \"50\",\n    \"defect_rate_pct\": \"0.2\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/v1/events",
            "description": "Switch to Org2 env + login to log this as Distributor."
          }
        },
        {
          "name": "Get Events for Target",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/events/{{shipmentId}}",
            "description": "Replace {{shipmentId}} with any product or shipment ID."
          }
        },
        {
          "name": "Get Events for Product",
